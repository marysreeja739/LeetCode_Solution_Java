public class Solution {
    public int rearrangeSticks(int n, int k) {
        // Fixed: Java uses underscores '_' instead of commas for large numbers
        int MOD = 1_000_000_007;
        
        // dp[i][j] represents ways to arrange i sticks with j visible
        long[][] dp = new long[n + 1][k + 1];
        
        // Base case: 0 sticks can only show 0 visible sticks in 1 way
        dp[0][0] = 1;
        
        // Build the dynamic programming table iteratively
        for (int i = 1; i <= n; i++) {
            // j cannot exceed the number of sticks available (i) or the target (k)
            for (int j = 1; j <= Math.min(i, k); j++) {
                // Apply the Stirling number recurrence formula
                dp[i][j] = (dp[i - 1][j - 1] + (i - 1) * dp[i - 1][j]) % MOD;
            }
        }
        
        return (int) dp[n][k];
    }
}
