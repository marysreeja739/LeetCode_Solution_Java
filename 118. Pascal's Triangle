import java.util.ArrayList;
import java.util.List;

public class Solution {
    public List<List<Integer>> generate(int numRows) {
        List<List<Integer>> triangle = new ArrayList<>();

        // Base case handling
        if (numRows <= 0) {
            return triangle;
        }

        // Loop to construct each row
        for (int i = 0; i < numRows; i++) {
            List<Integer> row = new ArrayList<>();

            for (int j = 0; j <= i; j++) {
                // First and last elements of every row are always 1
                if (j == 0 || j == i) {
                    row.add(1);
                } else {
                    // Sum of the two elements directly above
                    int leftAbove = triangle.get(i - 1).get(j - 1);
                    int rightAbove = triangle.get(i - 1).get(j);
                    row.add(leftAbove + rightAbove);
                }
            }
            
            triangle.add(row);
        }

        return triangle;
    }
}
