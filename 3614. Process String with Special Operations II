class Solution {
    public char processStr(String s, long k) {
        int n = s.length();
        long[] lengths = new long[n];
        long currLen = 0;
        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);
            if (Character.isLowerCase(ch)) {
                currLen++;
            } else if (ch == '*') {
                if (currLen > 0) {
                    currLen--;
                }
            } else if (ch == '#') {
                currLen *= 2;
            } else if (ch == '%') {
                
            }
            lengths[i] = currLen;
        }
        if (k < 0 || k >= currLen) {
            return '.';
        }
        long currK = k;
        for (int i = n - 1; i >= 0; i--) {
            char ch = s.charAt(i);
            long prevLen = (i > 0) ? lengths[i - 1] : 0;
            if (Character.isLowerCase(ch)) {
                if (currK == prevLen) {
                    return ch;
                }
            } else if (ch == '*') {
            } else if (ch == '#') {
                if (currK >= prevLen) {
                    currK -= prevLen;
                }
            } else if (ch == '%') {         
                currK = prevLen - 1 - currK;
            }
        }
        return '.';
    }
}
