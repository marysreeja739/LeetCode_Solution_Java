class Solution {
    public boolean isPalindrome(String s) {
        String cleaned = s.replaceAll("[^a-zA-Z0-9]", "").toLowerCase();
        int left=0;
        int right=cleaned.length()-1;
        int pal=0;
        while(left<right && pal!=1)
        {
            if(cleaned.charAt(left)==cleaned.charAt(right))
            {
                left++;
                right--;
            }
            else
            {
                pal=1;
            }
        }
        if(pal==0)
        {
            return true;
        }
        return false;
    }
}
